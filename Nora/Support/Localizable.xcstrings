    "Worth knowing": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đáng biết"
          }
        }
      }
    },
    "Yes, do that": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đúng vậy"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm qua"
          }
        }
      }
    },
    "You can adjust this anytime in Profile.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh có thể điều chỉnh bất cứ lúc nào trong Hồ sơ."
          }
        }
      }
    },
    "You hold OCB as a mid-term position, so Nora prioritizes earnings, leadership changes, dividends, and regulatory news.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang nắm giữ OCB theo chiến lược trung hạn, vì vậy Nora ưu tiên kết quả kinh doanh, thay đổi lãnh đạo, cổ tức và thông tin từ cơ quan quản lý."
          }
        }
      }
    },
    "You hold OCB — this directly affects your investment.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang nắm giữ OCB — đây là thông tin ảnh hưởng trực tiếp đến khoản đầu tư của anh."
          }
        }
      }
    },
    "You love sci-fi films, so Nora rolls new releases into your brief.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh thích phim khoa học viễn tưởng, nên Nora gom các phim mới ra mắt vào bản tóm tắt."
          }
        }
      }
    },
    "You love the sci-fi genre.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh thích thể loại phim khoa học viễn tưởng."
          }
        }
      }
    },
    "You work as an iOS Developer and follow SwiftUI, so Nora prioritizes new APIs and changes that could affect your work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh làm iOS Developer và đang theo dõi SwiftUI, nên Nora ưu tiên API mới và thay đổi có thể ảnh hưởng đến công việc."
          }
        }
      }
    },
    "You're a %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh làm %@"
          }
        }
      }
    },
    "You're an iOS Developer following SwiftUI to stay current at work.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang làm iOS Developer và theo dõi SwiftUI để cập nhật công việc."
          }
        }
      }
    },
    "You're considering a Mazda CX-5 in the next 6 months, so Nora tracks pricing, promotions, and new model years.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang cân nhắc mua Mazda CX-5 trong 6 tháng tới, nên Nora theo dõi giá, khuyến mãi và phiên bản mới."
          }
        }
      }
    },
    "You're considering a Mazda CX-5 in the next 6 months.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang cân nhắc mua Mazda CX-5 trong 6 tháng tới."
          }
        }
      }
    },
    "You're on the free plan. Upgrade for real-time alerts across every topic.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang dùng gói miễn phí. Nâng cấp để nhận cảnh báo tức thời cho mọi chủ đề."
          }
        }
      }
    },
    "You're planning a trip to Japan, so Nora tracks the exchange rate, weather, and flight prices.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang lên kế hoạch đi Nhật, nên Nora theo dõi tỷ giá, thời tiết và giá vé máy bay."
          }
        }
      }
    },
    "You're planning a trip to Japan, so exchange-rate moves affect your trip budget.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang lên kế hoạch đi Nhật, nên biến động tỷ giá ảnh hưởng đến ngân sách chuyến đi."
          }
        }
      }
    },
    "e.g. OCB, Liverpool FC": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ví dụ: OCB, Liverpool FC"
          }
        }
      }
    },
    "e.g. iOS Developer": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ví dụ: Lập trình viên iOS"
          }
        }
      }
    },
