    },
    "Weather": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời tiết"
          }
        }
      }
    },
    "What Nora is tracking": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nora đang theo dõi gì"
          }
        }
      }
    },
    "What are you investing in or keeping an eye on?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang đầu tư hoặc theo dõi tài sản nào?"
          }
        }
      }
    },
    "What do you do for work?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công việc hiện tại của anh là gì?"
          }
        }
      }
    },
    "What should Nora notify you about right away?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều gì anh muốn được thông báo ngay?"
          }
        }
      }
    },
    "What's on your mind?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang nghĩ gì?"
          }
        }
      }
    },
    "Which trim are you interested in?": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anh đang quan tâm phiên bản nào?"
          }
        }
      }
    },
    "Why this matters to you": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vì sao điều này quan trọng với anh"
          }
        }
