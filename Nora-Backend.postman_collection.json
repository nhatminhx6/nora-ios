              "raw": "{\n  \"displayName\": \"Minh\",\n  \"timezone\": \"Asia/Ho_Chi_Minh\",\n  \"locale\": \"vi\",\n  \"profession\": \"iOS Developer\",\n  \"interests\": [\"SwiftUI\", \"AI\"],\n  \"goals\": [\"Phát triển Nora\"],\n  \"locations\": [\"Ho Chi Minh City\"],\n  \"notificationIntensity\": \"balanced\",\n  \"dailyBriefTime\": \"08:00\"\n}",
