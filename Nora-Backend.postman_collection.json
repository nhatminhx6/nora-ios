    {
      "name": "Interests",
      "item": [
        {
          "name": "List interests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.[0]?.id) pm.collectionVariables.set('interestId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interests"
          }
        },
        {
          "name": "Get topic catalog",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interests/catalog?locale={{locale}}"
          }
        },
        {
          "name": "Create interest",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.id) pm.collectionVariables.set('interestId', body.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topicKey\": \"travel\",\n  \"refinements\": [\"Cửu Trại Câu\", \"Thành Đô\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/interests"
          }
        },
        {
          "name": "Update interest",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SwiftUI\",\n  \"description\": \"Theo dõi SwiftUI và iOS SDK\",\n  \"type\": \"TECHNOLOGY\",\n  \"status\": \"ACTIVE\",\n  \"config\": {\n    \"category\": \"work\",\n    \"relationship\": \"learning\",\n    \"priority\": \"high\",\n    \"trackingRules\": [\"API changes\", \"WWDC sessions\"],\n    \"notificationMode\": \"immediate\",\n    \"relevanceReason\": \"Đang phát triển Nora iOS\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/interests/{{interestId}}"
          }
        },
        {
          "name": "Pause interest",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PAUSED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/interests/{{interestId}}"
          }
        },
        {
          "name": "Resume interest",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/interests/{{interestId}}"
          }
        },
        {
          "name": "Delete interest",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/interests/{{interestId}}"
          }
        }
      ]
    },
    {
      "name": "Briefs and insights",
      "item": [
        {
          "name": "Sync real content now",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/ingestion/sync"
          }
        },
        {
          "name": "Get daily brief",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const first = body.data?.brief?.importantInsights?.[0] ?? body.data?.brief?.otherInsights?.[0];",
                  "if (first?.id) pm.collectionVariables.set('userInsightId', first.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/briefs/daily?date={{briefDate}}&locale={{locale}}",
              "host": ["{{baseUrl}}"],
              "path": ["briefs", "daily"],
              "query": [
                { "key": "date", "value": "{{briefDate}}" },
                { "key": "locale", "value": "{{locale}}" }
              ]
            }
          }
        },
        {
          "name": "Get interest insights",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.data?.[0]?.id) pm.collectionVariables.set('userInsightId', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/interests/{{interestId}}/insights?locale={{locale}}"
          }
        },
        {
          "name": "Mark insight useful",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"READ\",\n  \"isUseful\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user-insights/{{userInsightId}}"
          }
        },
        {
          "name": "Dismiss insight",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISMISSED\",\n  \"isUseful\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user-insights/{{userInsightId}}"
          }
        },
        {
          "name": "Save insight",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isSaved\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user-insights/{{userInsightId}}"
          }
        },
        {
          "name": "Unsave insight",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isSaved\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/user-insights/{{userInsightId}}"
          }
        }
      ]
    }
  ]
